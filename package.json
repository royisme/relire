{
  "name": "relire",
  "description": "French reading and pronunciation practice with AI feedback, for learners preparing for TCF Canada.",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.mjs --deny-warnings .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist dev-dist",
    "i18n:check": "bun scripts/check-i18n.ts",
    "shape:check": "bun scripts/check-code-shape.ts",
    "test": "bun test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.15",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.6",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royisme/relire.git"
